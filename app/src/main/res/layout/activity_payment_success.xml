<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="25dp">

        <!-- SUCCESS ICON -->

        <TextView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="45dp"
            android:background="#DDEFD9"
            android:gravity="center"
            android:text="✓"
            android:textColor="#5F8E5B"
            android:textSize="48sp"
            android:textStyle="bold" />


        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Payment Successful!"
            android:textColor="#292929"
            android:textSize="25sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Thank you for shopping with UJÉRA."
            android:textColor="#777777"
            android:textSize="13sp" />


        <!-- ORDER CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORDER NUMBER"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="UJ-ORDER"
                android:textColor="#292929"
                android:textSize="18sp"
                android:textStyle="bold" />


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#EEEEEE" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Payment Method"
                android:textColor="#888888"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPaymentMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="E-Wallet"
                android:textColor="#292929"
                android:textSize="15sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Total Payment"
                android:textColor="#888888"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTotalPayment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Rp0"
                android:textColor="#D98999"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- TRACK -->

        <Button
            android:id="@+id/btnTrackOrder"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#D98999"
            android:text="TRACK MY ORDER"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- HOME -->

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#C9E4F6"
            android:text="BACK TO HOME"
            android:textColor="#292929"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>