<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHomeLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UJÉRA"
                    android:textColor="#292929"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Hi, welcome back! 👋"
                    android:textColor="#666666"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- CART ICON -->

            <TextView
                android:id="@+id/tvCartIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="#DDEEFF"
                android:gravity="center"
                android:text="🛒"
                android:textSize="21sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TITLE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvFindTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Find your perfect pair"
            android:textColor="#292929"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFindSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Step into comfort, style &amp; confidence."
            android:textColor="#666666"
            android:textSize="13sp" />


        <!-- ================================================= -->
        <!-- SEARCH -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:hint="Search shoes..."
            android:inputType="text"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#292929"
            android:textColorHint="#888888"
            android:textSize="14sp" />


        <!-- ================================================= -->
        <!-- PROMO BANNER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="20dp"
            android:background="#F7C8D0"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEW COLLECTION"
                android:textColor="#292929"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Step into your style."
                android:textColor="#292929"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Discover shoes made for you."
                android:textColor="#555555"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CATEGORY TITLE -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Categories"
                android:textColor="#292929"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSeeAllCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="See all"
                android:textColor="#A94F65"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CATEGORY -->
        <!-- ================================================= -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- ALL -->

                <TextView
                    android:id="@+id/categoryAll"
                    android:layout_width="90dp"
                    android:layout_height="55dp"
                    android:background="#C9E4F6"
                    android:gravity="center"
                    android:text="All 👟"
                    android:textColor="#292929"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <!-- SNEAKERS -->

                <TextView
                    android:id="@+id/categorySneakers"
                    android:layout_width="90dp"
                    android:layout_height="55dp"
                    android:layout_marginStart="10dp"
                    android:background="#DDD4F5"
                    android:gravity="center"
                    android:text="Sneakers"
                    android:textColor="#292929"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <!-- RUNNING -->

                <TextView
                    android:id="@+id/categoryRunning"
                    android:layout_width="90dp"
                    android:layout_height="55dp"
                    android:layout_marginStart="10dp"
                    android:background="#D5E8D4"
                    android:gravity="center"
                    android:text="Running"
                    android:textColor="#292929"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <!-- SPORTS -->

                <TextView
                    android:id="@+id/categorySports"
                    android:layout_width="90dp"
                    android:layout_height="55dp"
                    android:layout_marginStart="10dp"
                    android:background="#FFD9C2"
                    android:gravity="center"
                    android:text="Sports"
                    android:textColor="#292929"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <!-- CASUAL -->

                <TextView
                    android:id="@+id/categoryCasual"
                    android:layout_width="90dp"
                    android:layout_height="55dp"
                    android:layout_marginStart="10dp"
                    android:background="#F7C8D0"
                    android:gravity="center"
                    android:text="Casual"
                    android:textColor="#292929"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </HorizontalScrollView>


        <!-- ================================================= -->
        <!-- PRODUCT TITLE -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPopularTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Popular Shoes"
                android:textColor="#292929"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSeeAllProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="See all"
                android:textColor="#A94F65"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PRODUCT GRID -->
        <!-- ================================================= -->

        <GridLayout
            android:id="@+id/productGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="2"
            android:orientation="horizontal"
            android:useDefaultMargins="false" />


        <!-- ================================================= -->
        <!-- BOTTOM NAVIGATION -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="25dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="6dp">

            <!-- HOME -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌂"
                    android:textColor="#D98999"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="#A94F65"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- CATEGORY -->

            <TextView
                android:id="@+id/tvBottomCategory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="☷&#10;Category"
                android:textColor="#666666"
                android:textSize="11sp" />


            <!-- ORDERS -->

            <TextView
                android:id="@+id/tvBottomOrders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▣&#10;Orders"
                android:textColor="#666666"
                android:textSize="11sp" />


            <!-- CART -->

            <TextView
                android:id="@+id/tvBottomCart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🛒&#10;Cart"
                android:textColor="#666666"
                android:textSize="11sp" />


            <!-- PROFILE -->

            <TextView
                android:id="@+id/tvBottomProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="●&#10;Profile"
                android:textColor="#666666"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BOTTOM SPACE -->
        <!-- ================================================= -->

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>

</ScrollView>