<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="#E7DDF6"
                android:gravity="center"
                android:text="‹"
                android:textColor="#5E4B6B"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Write a Review"
                android:textColor="#3D3445"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="45dp"
                android:layout_height="45dp" />

        </LinearLayout>


        <!-- PRODUCT CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#F7C8D0"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:background="#FFF9F5"
                android:gravity="center"
                android:text="👟"
                android:textSize="35sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urban Runner"
                    android:textColor="#3D3445"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="UJÉRA Collection"
                    android:textColor="#765E68"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Size 40 • Pink"
                    android:textColor="#765E68"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- RATING -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="How was your experience?"
            android:textColor="#3D3445"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="15dp"
            android:numStars="5"
            android:rating="5"
            android:stepSize="1" />


        <!-- REVIEW -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Tell us about your experience"
            android:textColor="#3D3445"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etReview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:gravity="top|start"
            android:hint="Write your review here..."
            android:inputType="textMultiLine"
            android:maxLines="6"
            android:padding="15dp"
            android:textColor="#3D3445"
            android:textColorHint="#A99CA2"
            android:textSize="14sp" />


        <!-- SUBMIT -->

        <Button
            android:id="@+id/btnSubmitReview"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#D98999"
            android:text="Submit Review"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="Your feedback helps us improve UJÉRA ♡"
            android:textColor="#A38F99"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>